# MotorClaim AI Intelligence Solution — Safe Sample Environment Configuration
APP_ENV=local
APP_NAME=MotorClaim AI Intelligence Solution
LOG_LEVEL=INFO

# Database (PostgreSQL in Docker, SQLite fallback for local dev/tests)
DATABASE_URL=sqlite:///./motor_claim_ai.db
# DATABASE_URL=postgresql+psycopg://motorclaim:motorclaim@localhost:5432/motorclaim

# Redis (optional for local dev, used in Docker)
REDIS_URL=redis://localhost:6379/0

# Security & Auth (CHANGE IN PRODUCTION)
JWT_SECRET_KEY=demo-synthetic-dev-secret-change-in-prod-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Evidence Vault Storage
EVIDENCE_STORAGE_DIR=./evidence_store
MAX_UPLOAD_SIZE_MB=25

# AI & Model Gateway (stub | gemini | anthropic)
AI_PROVIDER_MODE=stub
AI_SIMULATE_OUTAGE=false
GEMINI_API_KEY=your-gemini-api-key-placeholder
ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder

# Enterprise Integrations (mock | live)
INTEGRATION_MODE=mock

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
