{
 "dataset": "communication",
 "agent": "customer_communication",
 "version": "1.0.0",
 "description": "Customer communication: factual accuracy, approved-template compliance, consent, localisation and adverse-notice gating.",
 "base": {
  "input": {}
 },
 "cases": [
  {
   "id": "COMM-001",
   "category": "incomplete_claim",
   "description": "Missing-documents reminder names the claim and every missing document",
   "input": {
    "trigger_event": "documents_missing",
    "claim_number": "CLM-100",
    "missing_documents": [
     "Driving Licence (DL)",
     "Registration Certificate (RC)"
    ]
   },
   "expected": {
    "status": "completed",
    "trigger": "documents_missing",
    "contains": [
     "CLM-100",
     "Driving Licence (DL)",
     "Registration Certificate (RC)"
    ],
    "approved_template": true
   }
  },
  {
   "id": "COMM-002",
