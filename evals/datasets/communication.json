   "id": "COMM-011",
   "category": "policy_exclusion",
   "description": "An adverse communication is held for human approval, never auto-sent",
   "input": {
    "is_adverse": true,
    "trigger_event": "claim_declined",
    "claim_number": "CLM-110"
   },
   "expected": {
    "status": "needs_human",
    "routing": "held_for_human_comm_approval",
    "next": "human_comm_review",
    "action_status": "gated_human_review",
    "requires_human_review": true
   },
   "critical": true
  },
  {
   "id": "COMM-012",
   "category": "policy_exclusion",
   "description": "No WhatsApp consent: message is not sent on WhatsApp",
   "input": {
    "trigger_event": "survey_scheduled",
    "claim_number": "CLM-111",
    "consent_whatsapp": false
   },
   "expected": {
    "status": "completed",
    "effective_channel": "email",
    "wa_blocked": true,
    "sent_channel_not": "whatsapp",
    "reason_codes_include": [
     "RC_WHATSAPP_CONSENT_REQUIRED"
    ]
   },
   "critical": true
  },
