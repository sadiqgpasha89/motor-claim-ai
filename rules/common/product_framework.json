{
  "rule_id": "IN-PRODUCT-FRAMEWORK-2026",
  "version": "1.0.0",
  "jurisdiction": "IN",
  "title": "Product framework: KPI definitions, before and after table, outcome targets, curated demos, capability model, assessment (DEMO)",
  "source_reference": "Internal product framework. Synthetic values. Targets are illustrative ambition levels, not measured results.",
  "owner": "Product (DEMO)",
  "effective_from": "2026-01-01T00:00:00Z",
  "status": "published",
  "controls": {
    "kpis": [
      {
        "id": "avg_processing_time",
        "name": "Average claim processing time",
        "why": "Overall efficiency",
        "unit": "hours",
